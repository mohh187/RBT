app-release-*.idsig

# Android/TWA build output + machine-specific paths (the TWA SOURCE — app/src,
# build.gradle, twa-manifest.json, gradle wrapper — IS tracked; only the ~76 MB
# of generated artifacts and this machine's SDK path are not)
.gradle/
build/
local.properties
manifest-checksum.txt

# working media folders (venue photo/brand source material, ~135 MB — belongs in
