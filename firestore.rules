rules_version = '2';

// MenuLink Firestore security rules — multi-tenant isolation + RBAC.
//
// Model:
//   users/{uid}                      -> { tenantId, role }   (role: owner|manager|cashier|waiter|kitchen)
//   tenantSlugs/{slug}               -> { tenantId }          (public slug lookup)
//   tenants/{tid}                    -> venue profile/settings
//   tenants/{tid}/categories/{id}
//   tenants/{tid}/items/{id}
//   tenants/{tid}/tables/{id}
//   tenants/{tid}/offers/{id}
//   tenants/{tid}/orders/{id}
//   tenants/{tid}/waiterCalls/{id}
//   tenants/{tid}/customers/{id}
//
// Public (anonymous diners) may READ the menu and CREATE orders / waiter calls.
// Everything operational is restricted to authenticated staff of THAT tenant.
//
// ---------------------------------------------------------------------------
// OPEN: staff HR fields still readable by any member
// ---------------------------------------------------------------------------
// tenants/{tid}/staff/{uid} is `allow read: if isStaff(tid)` — the whole
// directory is peer-readable, and salary / deductions / managerRating / hireDate
// / phone all sit on that same document. One getDocs from a waiter's session
// dumps the owner's salary. WRITING those fields is already manager-only (the
// rule below admits only isManager or the staffer's own doc, and the self
// branch blocks every HR key), so this is a READ exposure, not a tampering one.
// Rules cannot hide individual fields, so closing it needs a data migration the
// owner must run:
//   1. Move salary, deductions, managerRating, hireDate, staffId and phone off
//      staff/{uid} into a sibling doc tenants/{tid}/staffHr/{uid}.
//   2. Add:  match /staffHr/{uid} { allow read, write: if hasCap(tid, 'manage_payroll'); }
//   3. Point the payroll screen, StaffProfile and functions/payroll at the new
//      path; leave staff/{uid} holding only directory fields (name, role, photo,
//      active, caps) which every colleague legitimately sees.
// Until then MANAGE_PAYROLL and VIEW_PERFORMANCE are UI-level gates only.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    // A fired or suspended staffer keeps their password, so membership cannot rest
    // on the users doc alone: without this, deactivating someone revoked NOTHING —
    // they kept orders, the CRM, materials and every storage delete right.
    // A MISSING staff doc stays allowed on purpose: it is both the bootstrap state
    // (the doc is self-registered on first login, and isStaff gates that create) and
    // the state of venues whose docs predate the `active` field. Same for a doc that
    // never carried `active` — hence the .get() default rather than a bare read.
    function staffActive(tid) {
      return !exists(/databases/$(database)/documents/tenants/$(tid)/staff/$(request.auth.uid))
        || get(/databases/$(database)/documents/tenants/$(tid)/staff/$(request.auth.uid)).data.get('active', true) != false;
    }
    function isMember(tid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().tenantId == tid
        && staffActive(tid);
    }
    function roleIn(tid, roles) {
      return isMember(tid) && (userDoc().role in roles);
    }
    // Any user bound to THIS tenant is staff (supports custom roles: supervisor,
    // barista, cleaner, ...). Only owner/manager are "managers" for privileged writes.
    function isStaff(tid) {
      return isMember(tid);
    }
    function isManager(tid) {
      return roleIn(tid, ['owner', 'manager']);
    }
    // Granular capability check. Managers hold every cap. A non-manager member holds
    // a cap only if it appears in the RESOLVED override array on their staff doc
    // (tenants/{tid}/staff/{uid}.caps) — which only a manager can write (see the
    // staff rule: `caps` is blocked from self-write). Absent override → no delegated
    // cap (they keep the isStaff-level access that other rules already grant).
    function staffCapsList(tid) {
      return get(/databases/$(database)/documents/tenants/$(tid)/staff/$(request.auth.uid)).data.caps;
    }
    function hasCap(tid, cap) {
      return isManager(tid)
        || (isMember(tid)
            && exists(/databases/$(database)/documents/tenants/$(tid)/staff/$(request.auth.uid))
            && ('caps' in get(/databases/$(database)/documents/tenants/$(tid)/staff/$(request.auth.uid)).data)
            && (cap in staffCapsList(tid)));
    }
    // Money capabilities, with a ROLE fallback. The caps mirror (staff/{uid}.caps)
    // is only written once a manager opens the admin (healStaffCapsMirrors), so a
    // bare hasCap() here would stop the till at any venue that never did — the
    // roles listed are exactly the ones holding the cap by default in
    // src/lib/permissions.js. Cost of the fallback: stripping the cap from a
    // cashier in the caps editor is still only enforced in the UI. Everyone else
    // (waiter, barista, kitchen, driver, cleaner, marketing) is now blocked in the
    // database, which is the hole this closes.
    function canRefund(tid) {
      return hasCap(tid, 'refund') || roleIn(tid, ['owner', 'manager', 'supervisor', 'accountant', 'cashier']);
    }
    function canCancel(tid) {
      return hasCap(tid, 'cancel_order') || roleIn(tid, ['owner', 'manager', 'supervisor', 'cashier']);
    }
    // Platform super-admin (console owner). Membership is the existence of a
    // platformAdmins/{uid} doc — created ONLY via Firebase Console / Admin SDK
    // (client writes are denied below), so it cannot be self-granted.
    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }
    // Platform super-admin. Role tiers (support/analyst) are meant to be
    // read/support-scoped; only a superAdmin may mutate tenants or fan out
    // platform-wide writes. A doc with NO `role` field is the original bootstrap
    // super (same convention as the setPlatformRole callable), so the first admin
    // keeps full power. isPlatformAdmin() stays the READ gate everywhere.
    function platformAdminDoc() {
      return get(/databases/$(database)/documents/platformAdmins/$(request.auth.uid)).data;
    }
    function isPlatformSuper() {
      return isPlatformAdmin()
        && (!('role' in platformAdminDoc()) || platformAdminDoc().role == 'superAdmin');
    }

    // ---- per-user profile ----
    match /users/{uid} {
      // A user may read their own profile; platform admins may read/manage any
      // account (support: fix a broken role/tenant binding).
      allow read: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow update, delete: if isPlatformAdmin();
      // On signup the user creates their own bootstrap profile. The body must NOT
      // seed a privileged binding out of thin air: an unconstrained create was a
      // full tenant-takeover hole — any signed-up user could write their own
      // users doc with {tenantId:'<victim>', role:'owner'} and every authz helper
      // (isMember/isManager/roleIn) trusts that doc. The elaborate update-rule
      // guards below were bypassed because a fresh account writes those values in
      // its FIRST write (a create), not an update. Mirror the same invariants on
      // create: bootstrap (no privileged keys — the real createUserProfile path),
      // OR owner self-onboard proven by the tenant named in the same tx, OR an
      // invite claim that matches a staffInvite for this email.
      // THE INVITE BRANCH IS GONE — DELIBERATELY. It authorised a privileged
      // create by looking up `staffInvites/$(request.resource.data.email)`,
      // i.e. against an email the writer chose in the same request. Any user
      // could name a pending manager invite's address and mint themselves a
      // manager binding. Staff bindings are now written ONLY by the
      // claimStaffInvites callable (Admin SDK, verified token email).
      // What remains: a plain bootstrap profile, or an owner proving ownership
      // of the tenant named in the same transaction.
      allow create: if isSignedIn() && request.auth.uid == uid
        && (
          !request.resource.data.keys().hasAny(['role', 'tenantId', 'caps'])
          || (request.resource.data.role == 'owner'
              && request.resource.data.tenantId != null
              && !request.resource.data.keys().hasAny(['caps'])
              && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == uid)
        );
      // `caps` (per-staffer capability overrides) is manager-owned — a staffer must
      // NOT be able to self-grant capabilities by writing their own users doc.
      // (role/tenantId already protected; caps was the privilege-escalation hole.)
      // NOTE: the owner branch MUST use getAfter() — venue creation links the user
      // to the tenant inside the SAME transaction that creates the tenant, and a
      // plain get() sees the PRE-transaction state (tenant not there yet), which
      // rejected the link and broke every fresh venue creation.
      // Same removal as create, and this is the branch that was actually
      // exploitable: it read `resource.data.email` — the field already sitting
      // on the attacker's own bootstrap doc — and granted {tenantId, role} on
      // the strength of it. An owner still self-links (proven by ownerUid);
      // everyone else is bound by the server.
      allow update: if isSignedIn() && request.auth.uid == uid
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'tenantId', 'caps'])
          || (request.resource.data.role == 'owner'
              && request.resource.data.tenantId != null
              && getAfter(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)).data.ownerUid == uid)
        );
    }

    // Which venues this user may SWITCH to. Deliberately a subcollection with
    // write:false, and NOT a field on users/{uid}: the update rule above lets
    // a user write any key that is not role/tenantId/caps, so a `memberships`
    // FIELD would sail straight through and let anyone grant themselves
    // membership of any venue. A subcollection has no such hole.
    //
    // This list is an INDEX FOR THE UI, not an authorization source —
    // switchTenant re-verifies against tenants/{tid}.ownerUid or an active
    // staff doc every time, so a stale row is inert.
    match /users/{uid}/memberships/{tid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow write: if false;
    }

    // ---- public slug -> tenant lookup ----
    match /tenantSlugs/{slug} {
      allow read: if true;
      allow create: if isSignedIn(); // claimed during onboarding; uniqueness enforced by doc id == slug
      allow update, delete: if false;
    }

    // ---- public custom-domain / subdomain -> tenant lookup (doc id == hostname) ----
    // Public read so the menu resolves at load. A manager may REQUEST a domain
    // (status 'pending'); only the platform activates it (after DNS + SSL), so a
    // venue can't hijack another's hostname or self-activate.
    match /domains/{host} {
      allow read: if true;
      allow create: if isPlatformAdmin()
        || (isSignedIn() && isManager(request.resource.data.tenantId)
            && request.resource.data.status == 'pending');
      allow update: if isPlatformAdmin();
      // A venue may cancel its OWN still-pending request; only the platform
      // touches an active domain (anti-hijack).
      allow delete: if isPlatformAdmin()
        || (isManager(resource.data.tenantId) && resource.data.status == 'pending');
    }

    // ---- payment intents (order / subscription / booking checkout) ----
    // Created + settled ONLY by Cloud Functions (admin SDK, server-derived amount).
    // Public read by the unguessable auto-id so a client can poll its own status;
    // no client writes (prevents amount/status tampering).
    match /payIntents/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---- staff invites ----
    // Doc id is `{emailLower}__{tenantId}`, so one address may hold a pending
    // invite at several venues at once (the old email-only id allowed exactly
    // one platform-wide, and claiming it evicted the user from wherever they
    // already worked).
    //
    // CLAIMING IS SERVER-SIDE ONLY — the claimStaffInvites callable, which
    // reads the address Firebase verified. It used to be a client read + a
    // self-write, and that was a privilege-escalation chain: `allow get: if
    // isSignedIn()` let anyone probe for a pending manager invite, and the
    // users-doc rules then authorised the escalation against an `email` field
    // the attacker had written themselves. Hence: no public get, no public
    // delete, and the invite branches in /users are gone.
    match /staffInvites/{id} {
      allow get, list: if isPlatformAdmin() || (isSignedIn() && isManager(resource.data.tenantId));
      allow create, update: if isSignedIn() && isManager(request.resource.data.tenantId);
      // Only the venue that issued it may cancel it. Previously ANY signed-in
      // account could delete ANY venue's pending invites.
      allow delete: if isPlatformAdmin() || (isSignedIn() && isManager(resource.data.tenantId));
    }

    // ---- tenant root ----
    // ---- digital signage screens: doc id = the pairing code the TV enters.
    //      TVs read anonymously; only staff of the owning venue manage. ----
    match /screens/{code} {
      // The doc id IS the pairing code a TV types in, so a world-readable LIST
      // handed anyone every venue on the platform plus the code to attach a rogue
      // display. A paired TV only ever opens its own doc by that code, so `get`
      // stays public; both listings in the app already filter by tid
      // (watchScreens, platform/VenueDetail), so the per-doc check passes.
      allow get: if true;
      allow list: if isStaff(resource.data.tid) || isPlatformAdmin();
      allow create: if isStaff(request.resource.data.tid);
      // Anonymous paired TVs may write ONLY their health heartbeat (last-seen +
      // which slide is playing) — nothing else on the doc is reachable publicly.
      allow update: if isStaff(resource.data.tid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'nowIdx']);
      allow delete: if isStaff(resource.data.tid);
    }

    match /tenants/{tid} {
      // Public can read venue profile (needed to render the public menu/branding).
      allow read: if true;
      // Owner creates their tenant during onboarding — but may NOT self-assign
      // platform-owned subscription/suspension fields.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['plan', 'planStatus', 'planExpiresAt', 'active', 'suspendReason', 'platformNote', 'features']);
      // Managers update venue settings, but subscription/suspension fields are
      // platform-owned (set only from the platform console). A staffer holding a
      // settings-domain cap (appearance / loyalty / campaigns / integrations /
      // settings) may also save — but NEVER roleCaps (self-escalation via the
      // role-defaults mirror) or the messaging quota counters.
      allow update: if isPlatformSuper()
        || (isManager(tid)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 // msgsSent/msgCapMonthly were listed ONLY on the hasCap branch below,
                 // so an owner/manager could raise their own WhatsApp quota — i.e.
                 // spend the PLATFORM's money without limit. Same for the AI meters.
                 .hasAny(['plan', 'planStatus', 'planExpiresAt', 'active', 'suspendReason', 'platformNote', 'ownerUid', 'features',
                          'msgsSent', 'msgCapMonthly', 'aiLimits', 'aiExtra', 'ar3dMonthly', 'ar3dUnlimited', 'dinerAiMonthly',
                          // spendCaps/spendCapsDaily are the per-venue overrides the
                          // spend meter reads (functions/spend.js). Writable by the
                          // venue they would be a self-service «raise my own bill»
                          // switch — the exact hole msgCapMonthly used to be.
                          // spendExtra is the PURCHASED balance: it is credited only
                          // by the payment webhook and debited only by the meter, so
                          // a client write would be minting paid credit for free.
                          'spendCaps', 'spendCapsDaily', 'spendExtra',
                          // groupId binds a venue to an owning group. Writable by
                          // the venue, a manager could join someone else's group
                          // and read its billing — and later ride its subscription.
                          // Added BEFORE the branch feature exists, because a
                          // deny-key is strictly more restrictive and no document
                          // carries the field yet. (branchLabel stays writable —
                          // it is cosmetic.)
                          'groupId',
                          'smsApiKey']))
        || ((hasCap(tid, 'manage_settings') || hasCap(tid, 'manage_appearance') || hasCap(tid, 'manage_loyalty') || hasCap(tid, 'manage_campaigns') || hasCap(tid, 'manage_integrations'))
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['plan', 'planStatus', 'planExpiresAt', 'active', 'suspendReason', 'platformNote', 'ownerUid', 'features', 'roleCaps', 'msgsSent', 'msgCapMonthly',
                          'aiLimits', 'aiExtra', 'ar3dMonthly', 'ar3dUnlimited', 'dinerAiMonthly',
                          'spendCaps', 'spendCapsDaily', 'spendExtra', 'groupId', 'smsApiKey']));
      allow delete: if roleIn(tid, ['owner']) || isPlatformSuper();

      // Platform admins READ every tenant subcollection (support & oversight from
      // the console); only a superAdmin may WRITE tenant data — a support/analyst
      // tier must not be able to mutate another venue's orders/menu/customers.
      match /{document=**} {
        allow read: if isPlatformAdmin();
        allow write: if isPlatformSuper();
      }

      // ---- menu catalogue: public read; manager OR a staffer granted manage_menu ----
      match /categories/{id} {
        allow read: if true;
        allow write: if hasCap(tid, 'manage_menu');
      }
      match /items/{id} {
        allow read: if true;
        allow create, delete: if hasCap(tid, 'manage_menu');
        // Updating is menu-cap work, but CHANGING price-bearing fields additionally
        // needs edit_prices (managers hold both). Unchanged fields don't appear in
        // affectedKeys, so availability/star/sort/archive edits pass untouched.
        allow update: if hasCap(tid, 'manage_menu')
          && (hasCap(tid, 'edit_prices')
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'variants']));
      }

      // ---- item reviews: guests submit + read, managers moderate ----
      match /reviews/{id} {
        allow read: if true;
        // Public write, but bounded: only the known review fields, rating 1-5, and
        // capped text — so the public collection can't be stuffed with arbitrary or
        // oversized payloads.
        allow create: if request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.keys().hasOnly(['itemId', 'itemNameAr', 'itemNameEn', 'name', 'rating', 'comment', 'staffUid', 'createdAt'])
          && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 1000))
          && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120));
        allow update, delete: if isManager(tid);
      }
      match /offers/{id} {
        allow read: if true;
        allow write: if hasCap(tid, 'manage_offers');
      }
      match /tables/{id} {
        // Diners resolve a table by its qrToken (read needed); managers (or a staffer
        // granted manage_tables) manage tables. Order-taking staff may flip ONLY the
        // stored occupancy field (seat a walk-in, free a table) — layout, labels and
        // QR tokens stay manage_tables-only.
        allow read: if true;
        allow write: if hasCap(tid, 'manage_tables');
        // occupancy shape is pinned: without it the escape hatch doubled as a
        // public-read storage primitive (any order-taker could park an
        // arbitrarily large map on a world-readable doc).
        allow update: if hasCap(tid, 'manage_tables')
          || (hasCap(tid, 'take_orders')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['occupancy', 'updatedAt'])
              && request.resource.data.occupancy is map
              && request.resource.data.occupancy.keys().hasOnly(['state', 'since', 'byName', 'byUid', 'orderId', 'partySize']));
      }

      // ---- events (café-hosted): public read; manager OR manage_events ----
      match /events/{id} {
        allow read: if true;
        allow write: if hasCap(tid, 'manage_events');
      }

      // ---- tickets: diners book + view-by-id, staff manage/check-in ----
      match /tickets/{id} {
        allow get: if true;
        allow list: if isStaff(tid);
        // A diner may create ONLY a 'pending' ticket. FREE tickets are issued by
        // the issueFreeTicket Cloud Function (Admin SDK, re-derives price==0 from
        // the event); priced ones are flipped 'pending'→'valid' by the payment
        // webhook. This blocks self-issuing a 'valid' (esp. a free-priced-0) ticket
        // for a PAID event. Payment-proof fields are server-owned, never seeded by
        // a diner (else a 'pending' ticket could masquerade as already paid).
        // NOTE: deploy functions + client BEFORE this rule (free tickets route
        // through the callable; otherwise diner free-ticket creation is rejected).
        allow create: if isStaff(tid)
          || (request.resource.data.status == 'pending'
              && !request.resource.data.keys().hasAny(['paidOnline', 'paymentRef', 'paymentStatus', 'paidAt']));
        allow update: if isStaff(tid);
        allow delete: if isManager(tid);
      }

      // ---- reservations: diners request + view-by-id, staff confirm/decline ----
      match /reservations/{id} {
        allow get: if true;
        allow list: if isStaff(tid);
        // A diner requests a reservation as 'requested'. The deposit is server-
        // settled (webhook), so a diner may only seed depositStatus 'pending' and
        // never any payment-proof field — otherwise a booking could show a paid
        // deposit that was never collected.
        allow create: if isStaff(tid)
          || (
            request.resource.data.status == 'requested'
            && (!('depositStatus' in request.resource.data) || request.resource.data.depositStatus == 'pending')
            && !request.resource.data.keys().hasAny(['paidOnline', 'paymentRef', 'depositPaidAt'])
          );
        allow update: if isStaff(tid);
        allow delete: if isManager(tid);
      }

      // ---- public mirror docs (e.g. ready-order codes for signage TVs) ----
      match /public/{docId} {
        allow read: if true;
        allow write: if isStaff(tid);
      }

      // ---- receipts / tax invoices: written ONLY by Cloud Functions (numbered,
      // amount-authoritative, ZATCA). A customer opens their OWN invoice by its
      // unguessable auto-id (get); LISTING is staff-only — receipts carry buyer
      // name+phone, so a public `list` would leak the whole customer roster. ----
      match /receipts/{id} {
        allow get: if true;
        allow list: if isStaff(tid);
        allow write: if false;
      }

      // ---- orders: diners create + track-by-id, staff manage ----
      match /orders/{id} {
        // get: a diner may read THEIR order by its (unguessable) id to track status.
        allow get: if true;
        // list/query: staff only (prevents enumerating all orders).
        allow list: if isStaff(tid);
        // A suspended venue (active == false) stops accepting orders.
        // BOTH tenant reads go through .get() WITH A DEFAULT: rules ERROR on a
        // direct read of a missing key, and an errored condition denies the
        // write. Most tenants never touched the pause toggle, so ordersPaused
        // does not exist on their doc — every diner order at those venues was
        // rejected as permission-denied («المتجر لا يستقبل الطلبات حالياً»
        // at كافيه مزاج فال, confirmed by reading the live doc: no such field).
        allow create: if true
          && get(/databases/$(database)/documents/tenants/$(tid)).data.get('active', true) != false
          // ordering paused (kitchen slammed / closed early) blocks diner orders;
          // staff (cashier) may still ring up at the counter.
          && (get(/databases/$(database)/documents/tenants/$(tid)).data.get('ordersPaused', false) != true || isStaff(tid))
          // 'pending' = cash/terminal (reaches staff now); 'awaiting_payment' =
          // online, held until the payment settles (server flips it to 'pending').
          && (request.resource.data.status == 'pending'
              || request.resource.data.status == 'awaiting_payment')
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          // Only real staff may mark an order 'cashier'-sourced. onNewOrder trusts
          // that tag to honor a manual staff discount below the offer floor; a diner
          // must not be able to forge it to underpay.
          && (request.resource.data.get('source', '') != 'cashier' || isStaff(tid));
        // Only staff move orders through their lifecycle — and a delivery
        // driver only through the DELIVERY lane: every driver write (claim /
        // release / advance / COD custody / live geo) touches only the
        // `delivery` map + `updatedAt`, so a compromised driver session
        // cannot rewrite items or totals, flip the order paid, or cancel it.
        // Other roles keep full lifecycle writes (cashier settles, kitchen
        // advances, managers correct).
        allow update: if isStaff(tid)
          && (userDoc().role != 'driver'
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivery', 'updatedAt']))
          // NO RESURRECTION. Order status writes are now latency-compensated
          // updateDoc (not a server transaction), so an OFFLINE device can queue
          // an "advance" against a stale snapshot and, on reconnect, overwrite a
          // settlement another device already made — flipping a paid/cancelled/
          // refunded order back into an active status (kitchen re-cooks a
          // cancelled order; a paid order becomes collectible again). A settled/
          // void order may only stay put, or move paid -> refunded (the one
          // legitimate terminal transition). Everything else on a terminal order
          // is rejected server-side; the offending optimistic write rolls back.
          && (
            !(resource.data.status in ['paid', 'cancelled', 'refunded'])
            || request.resource.data.status == resource.data.status
            || (resource.data.status == 'paid' && request.resource.data.status == 'refunded')
          )
          // MONEY NEEDS THE CAP, NOT JUST A BADGE. isStaff alone let a waiter
          // holding only take_orders settle, comp or refund straight from the
          // database — the UI hid the buttons, nothing else did. An UNCHANGED
          // status is not a transition, so a waiter may still touch notes or the
          // table on an already-paid order.
          && (request.resource.data.status == resource.data.status
              || !(request.resource.data.status in ['paid', 'refunded'])
              || canRefund(tid))
          && (request.resource.data.status == resource.data.status
              || request.resource.data.status != 'cancelled'
              || canCancel(tid))
          && (!request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['paymentMethod', 'compDiscount', 'refund', 'refundTotal', 'refunds'])
              || canRefund(tid));
        allow delete: if isManager(tid);
      }

      // ---- stories: public menu strip — anyone reads, staff manage,
      //      diners may only bump likes/views by exactly +1 ----
      // ---- diner-facing notices: anyone reads (shown in the menu bell); manager OR
      //      a marketing staffer granted manage_campaigns writes ----
      match /notices/{id} {
        allow read: if true;
        allow write: if hasCap(tid, 'manage_campaigns');
      }

      match /stories/{id} {
        allow read: if true;
        allow create, delete: if isStaff(tid);
        allow update: if isStaff(tid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && request.resource.data.likes == resource.data.likes + 1)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
              && request.resource.data.views == resource.data.views + 1);

        // STORY REPLIES — anyone may send a short text; staff read & moderate.
        //
        // This block lived under /posts, one match block too far down, while the
        // only writer in the app (addStoryReply, src/lib/db.js) targets
        //   tenants/{tid}/stories/{sid}/replies/{rid}
        // Rules are deny-by-default, so EVERY diner reply was refused, always —
        // and an empty catch on the client plus an error-to-empty-array on the
        // staff listener made it look like a dead button and an empty inbox
        // rather than a permission failure. Its own comment already said
        // "story replies"; it was simply nested under the wrong parent.
        match /replies/{rid} {
          allow read, delete: if isStaff(tid);
          allow create: if request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() < 300;
        }
      }

      // ---- venue profile posts: public read of published, staff manage,
      //      diners may only bump likes/views by exactly +1 ----
      match /posts/{id} {
        allow get, list: if resource == null || resource.data.published == true || isStaff(tid);
        allow create, delete: if isStaff(tid);
        allow update: if isStaff(tid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
              && request.resource.data.likes == resource.data.likes + 1)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
              && request.resource.data.views == resource.data.views + 1);

        // Post replies. Nothing in the client writes here today — the block that
        // used to sit at this spot was the STORY reply rule, misfiled; it now
        // lives under /stories where its only writer actually points. Kept so a
        // future post-reply feature has the same contract, deliberately identical.
        match /replies/{rid} {
          allow read, delete: if isStaff(tid);
          allow create: if request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() < 300;
        }
      }

      // ---- waiter calls: diners create + follow their own, staff resolve ----
      //
      // GET vs LIST, split for the same reason orders are (see :369/:371).
      // A guest must be able to watch the ONE call they placed, so that «النادل
      // في الطريق» is a fact reported by the floor rather than a claim the
      // button made on tap. That is a `get` on a document whose id they were
      // handed and nobody else can guess. `list` stays staff-only: enumerating
      // waiterCalls would hand any diner every table's requests, and a rule
      // cannot inspect a where() clause to narrow it to their own.
      match /waiterCalls/{id} {
        allow get: if true;
        allow list: if isStaff(tid);
        allow create: if request.resource.data.status == 'open';
        allow delete: if isStaff(tid);
        // Staff do anything. A guest may only APPEND to the call they hold:
        // add words to the request, put it back in the queue, and bump the
        // repeat counter. They cannot resolve it, re-table it, or claim it —
        // status is pinned to 'open', so «تم» and «في الطريق» stay staff acts.
        allow update: if isStaff(tid)
          || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reason', 'status', 'repeats', 'createdAt'])
              && request.resource.data.status == 'open'
              && request.resource.data.reason is string
              && request.resource.data.reason.size() < 400
              && request.resource.data.repeats is int
              && request.resource.data.repeats == resource.data.get('repeats', 0) + 1);
      }

      // ---- shared table sessions («الطلب الجماعي»): every guest at the table
      // reads and writes the same live basket. Guests are anonymous devices, so
      // creation/updates are open like waiterCalls — but bounded: the doc must
      // stay small, keep its table identity, and only staff may close/delete it.
      match /tableSessions/{id} {
        allow read: if true;
        allow create: if true
          && request.resource.data.status == 'open'
          && request.resource.data.lines.size() <= 60;
        allow update: if isStaff(tid)
          || (request.resource.data.tableId == resource.data.tableId
              && request.resource.data.lines.size() <= 60
              && request.resource.data.guests.size() <= 20);
        allow delete: if isStaff(tid);
      }

      // ---- ads / menu popups: guests must READ them to see them, but only the
      // marketing role may create or edit. The stats counters are the one part
      // a guest device may touch, and only by incrementing — so an impression
      // can be recorded without opening the whole document to the public.
      match /ads/{id} {
        allow read: if true;
        allow create, delete: if hasCap(tid, 'manage_campaigns');
        allow update: if hasCap(tid, 'manage_campaigns')
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats']);
      }

      // ---- tournaments: the venue defines them, guests only watch the board.
      match /tournaments/{id} {
        allow read: if true;
        allow write: if hasCap(tid, 'manage_campaigns') || isManager(tid);

        // A player posts their OWN standing row and nobody else's: the doc id is
        // the device id, so overwriting a rival's score is structurally
        // impossible rather than merely discouraged. The guest board reads these
        // instead of gamePlays on purpose — gamePlays carry customer phones.
        match /entries/{deviceId} {
          allow read: if true;
          allow create, update: if request.resource.data.deviceId == deviceId
            && request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score <= 100000
            && request.resource.data.name.size() <= 24;
          allow delete: if isManager(tid);
        }
      }

      // ---- group happy hour: same one-row-per-device-per-day scheme as
      // gameScores, pinned by doc id for the same reason.
      match /happyHourScores/{id} {
        allow read: if true;
        allow create, update: if request.resource.data.score is number
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100000
          && request.resource.data.name.size() <= 24
          && id == request.resource.data.deviceId + '_' + request.resource.data.day;
        allow delete: if isManager(tid);
      }

      // ---- open challenges left for the next guest. Anyone may post one and
      // anyone may record beating it, so the text is bounded here as well as
      // sanitized client-side: this is user content shown to strangers.
      // The key allowlist is the important part, not the length checks: without
      // it a guest can satisfy the three validated fields and attach a megabyte
      // of junk under any other name, filling the venue's database at the
      // venue's expense. Bounding the fields we know about is not enough; the
      // document must be closed to fields we do not.
      match /challenges/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(
            ['gameId', 'byName', 'byDeviceId', 'score', 'message', 'at', 'expiresAt', 'beatenBy', 'active'])
          && request.resource.data.message.size() <= 120
          && request.resource.data.gameId.size() <= 64
          && request.resource.data.byDeviceId.size() <= 64
          && request.resource.data.score is number
          && request.resource.data.byName.size() <= 24
          && request.resource.data.beatenBy.size() == 0;
        allow update: if request.resource.data.keys().hasOnly(
            ['gameId', 'byName', 'byDeviceId', 'score', 'message', 'at', 'expiresAt', 'beatenBy', 'active'])
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.byDeviceId == resource.data.byDeviceId
          && request.resource.data.score == resource.data.score
          && request.resource.data.message == resource.data.message
          && request.resource.data.beatenBy.size() <= 50;
        allow delete: if isStaff(tid);
      }

      // ---- table-versus-table matches: created and scored by the playing
      // devices, bounded to the two tables they name.
      // An update used to pin NOTHING, so any guest could rewrite which tables
      // played and hand themselves the win. Identity is now immutable: the
      // tables, the game and the start time cannot change after creation.
      //
      // Stated plainly: this does NOT stop a determined guest forging the SCORE
      // of a match they are part of. Diners are anonymous — there is no identity
      // for a rule to bind a score to — so pretending otherwise would be
      // security theatre. What it does guarantee is that a match cannot be
      // reassigned to different tables, and that the collection cannot be used
      // as free storage.
      match /matches/{id} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(
            ['gameId', 'tableA', 'tableB', 'roomId', 'scoreA', 'scoreB', 'status',
             'startedAt', 'updatedAt', 'deviceIds'])
          && request.resource.data.gameId is string
          && request.resource.data.gameId.size() <= 64
          && request.resource.data.scoreA is number
          && request.resource.data.scoreB is number
          && request.resource.data.deviceIds.size() <= 8;
        allow update: if request.resource.data.keys().hasOnly(
            ['gameId', 'tableA', 'tableB', 'roomId', 'scoreA', 'scoreB', 'status',
             'startedAt', 'updatedAt', 'deviceIds'])
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.tableA.id == resource.data.tableA.id
          && request.resource.data.tableB.id == resource.data.tableB.id
          && request.resource.data.startedAt == resource.data.startedAt
          && request.resource.data.scoreA is number
          && request.resource.data.scoreB is number
          && request.resource.data.deviceIds.size() <= 8;
        allow delete: if isStaff(tid);
      }

      // ---- multiplayer rooms: four phones around one table (or an invited
      // friend) share a live board. Guests are anonymous, so a room is readable
      // by anyone AND listable by anyone (the "who did I play with" feature
      // queries the collection). Treat every field on this document as
      // PUBLISHED.
      //
      // That is not a loose analogy to waiterCalls — waiterCalls is staff-read
      // only, the exact opposite. It was described that way here once, and a
      // phone number was stored on each player as a result: any diner could
      // query this collection and harvest the name and mobile of every guest who
      // had played that day. NEVER put personal data on a room. The client no
      // longer writes a phone (see normalizePlayer in gameRoom.js) and a rejoin
      // scrubs legacy ones.
      //
      // Fair play is enforced by the pure reducer running inside a transaction,
      // not by these rules — a rule cannot know whose turn it is, and pretending
      // otherwise would be security theatre.
      match /rooms/{roomId} {
        allow read: if true;
        allow create: if request.resource.data.roomId == roomId
          && request.resource.data.players.size() <= 4;
        allow update: if request.resource.data.roomId == resource.data.roomId
          && request.resource.data.gameId == resource.data.gameId
          && request.resource.data.players.size() <= 4
          && request.resource.data.moves.size() <= 200;
        allow delete: if isStaff(tid);
      }

      // ---- game plays: the full record of what a guest played and answered.
      // The diner's own device writes it (anonymous); only staff read it. Same
      // bounding philosophy as sessions — capped arrays, immutable identity.
      match /gamePlays/{playId} {
        allow read: if isStaff(tid);
        allow create: if request.resource.data.playId == playId
          && request.resource.data.answers.size() <= 120;
        allow update: if request.resource.data.playId == resource.data.playId
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.answers.size() <= 120;
        allow delete: if isManager(tid);
      }

      // ---- player rollups: one per device, the guest's own play history.
      //
      // Honest limit, stated rather than papered over: diners are anonymous, so
      // a rule CANNOT prove that the device writing profile X is device X. Doc-id
      // pinning stops a stray write landing on the wrong row; it does not stop
      // someone who has learned another device id from deliberately targeting it.
      //
      // So the blast radius is capped instead. A guest write may only touch the
      // play-rollup keys, and the row is bounded. Staff read this to understand
      // their guests, and they must not be reading numbers a stranger planted.
      match /playerProfiles/{deviceId} {
        allow read: if isStaff(tid);
        allow create, update: if request.resource.data.deviceId == deviceId
          && deviceId.size() <= 64
          // Keep this list in sync with mergeIntoProfile() in src/lib/gameMemory.js.
          // It drifted once — 'insight', 'completedPlays' and 'tags' were being
          // written but were not allowed, so every guest rollup was denied.
          && request.resource.data.keys().hasOnly(
            ['deviceId', 'customerName', 'customerPhone', 'totalPlays', 'totalScore',
             'totalDurationMs', 'completedPlays', 'byGame', 'knowledge', 'insight',
             'tags', 'archetype', 'traits',
             'firstAt', 'lastAt', 'lastGameId', 'lastGameAr', 'lastScore', 'updatedAt'])
          // Counters arrive as server-side increments, which are not part of
          // request.resource.data — so bound byGame only when it IS present.
          && (!('byGame' in request.resource.data) || request.resource.data.byGame.size() <= 60)
          && (!('tags' in request.resource.data) || request.resource.data.tags.size() <= 12)
          && (!('customerName' in request.resource.data)
              || request.resource.data.customerName == null
              || request.resource.data.customerName.size() <= 24);
        allow delete: if isManager(tid);
      }

      // ---- AI generation log: staff-only end to end (prompts can contain the
      // venue's private marketing thinking, so guests never read this).
      match /aiGenerations/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid);
        allow update, delete: if isManager(tid);
      }

      // ---- behaviour sessions: one doc per guest visit, written by the diner's
      // own device (anonymous) and read only by staff. Bounded so a hostile
      // client cannot use it as free storage: the events/search arrays are
      // capped by the SDK and re-checked here, and the doc may never change the
      // session id it was created with. Guests never read each other's rows.
      match /sessions/{sid} {
        allow read: if isStaff(tid);
        allow create: if request.resource.data.sid == sid
          && request.resource.data.events.size() <= 300
          && request.resource.data.search.size() <= 20;
        allow update: if request.resource.data.sid == resource.data.sid
          && request.resource.data.events.size() <= 300
          && request.resource.data.search.size() <= 20;
        allow delete: if isManager(tid);
      }

      // ---- waiting-game scores («لوحة صدارة الصيادين»): guests post their own
      // score, everyone reads the board, managers can prune it.
      // Doc id is `${deviceId}_${YYYY-MM}` so a device owns exactly one row per
      // month — enforced structurally here rather than by query. Diners are
      // anonymous, so the score RANGE is the real guard (a hostile client can
      // still post any value inside it; this is a game board, not money).
      match /gameScores/{id} {
        allow read: if true;
        allow create, update: if request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 100000
          && request.resource.data.name.size() <= 24
          && id == request.resource.data.deviceId + '_' + request.resource.data.month;
        allow delete: if isManager(tid);
      }

      // ---- accounting: the venue's books. Money data is manager-only (plus a
      // staffer explicitly granted view_revenue for read access).
      match /accounts/{id} {
        allow read: if isSignedIn() && (isManager(tid) || hasCap(tid, 'view_revenue'));
        allow write: if isManager(tid);
      }
      match /journal/{id} {
        allow read: if isSignedIn() && (isManager(tid) || hasCap(tid, 'view_revenue'));
        allow write: if isManager(tid);
      }
      match /accountingDocs/{id} {
        allow read: if isSignedIn() && (isManager(tid) || hasCap(tid, 'view_revenue'));
        allow write: if isManager(tid);
      }

      // ---- cashier sessions (cash drawer): staff open/close their till ----
      match /cashierSessions/{id} {
        allow read: if isStaff(tid);
        allow create, update: if isStaff(tid);
        allow delete: if isManager(tid);
      }

      // ---- raw materials inventory: staff read + update (sale deductions / receive / count),
      // managers add/remove materials. Not public. ----
      match /materials/{id} {
        allow read: if isStaff(tid);
        allow update: if isStaff(tid);
        allow create, delete: if hasCap(tid, 'manage_inventory');
      }
      // ---- stock movements log: staff append (sales/receive/waste), managers correct ----
      match /stockMoves/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid);
        allow update, delete: if isManager(tid);
      }
      // ---- suppliers: staff read, manager OR manage_inventory manages ----
      match /suppliers/{id} {
        allow read: if isStaff(tid);
        allow write: if hasCap(tid, 'manage_inventory');
      }
      // ---- purchase orders: staff create/receive, manager OR manage_inventory corrects/deletes ----
      match /purchaseOrders/{id} {
        allow read: if isStaff(tid);
        allow create, update: if isStaff(tid);
        allow delete: if hasCap(tid, 'manage_inventory');
      }
      // ---- supplier payments ledger: staff append, managers correct ----
      match /supplierPayments/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid);
        allow update, delete: if isManager(tid);
      }
      // ---- AI assistant audit log: any assistant user appends; managers read ----
      match /aiLog/{id} {
        allow read: if isManager(tid);
        allow create: if hasCap(tid, 'use_assistant');
        allow update, delete: if false;
      }

      // AI durable memory (self-learning). Staff-scoped to this venue only; the
      // assistant reads it into context and writes insights via remember_fact.
      match /aiMemory/{id} {
        allow read, write: if isStaff(tid);
      }

      // Marketing campaigns (scheduled WhatsApp blasts) — manager OR a marketing
      // staffer granted manage_campaigns; the processCampaigns Cloud Function
      // (Admin SDK) does the actual sending.
      match /campaigns/{id} {
        allow read: if isStaff(tid);
        allow write: if hasCap(tid, 'manage_campaigns');
      }

      // Marketing post drafts (AI/manual designs awaiting approval before any
      // publish). Campaigns-capability owns the whole approve/publish flow.
      match /marketingPosts/{id} {
        allow read: if isStaff(tid);
        allow write: if hasCap(tid, 'manage_campaigns');
      }

      // Saved-card TOKENS — server-only (Admin SDK). The payable token must never
      // be client-readable; diners list/charge/delete via callable functions that
      // verify the owning device and re-derive the amount server-side.
      match /savedCards/{id} {
        allow read, write: if false;
      }
      // ---- expenses (operating costs): managers manage ----
      match /expenses/{id} {
        allow read: if isStaff(tid);
        allow write: if isManager(tid);
      }

      // ---- complaints: diners submit, staff read & resolve ----
      match /complaints/{id} {
        // Complaints are an ADMIN feed — a waiter's bell must not stream them.
        // (Clients also stop subscribing without the cap; this is the backstop.)
        allow read: if hasCap(tid, 'view_complaints');
        allow create: if true
          && request.resource.data.status == 'open'
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0;
        allow update, delete: if hasCap(tid, 'view_complaints');
      }

      // ---- customers (CRM) ----
      // Staff read + full write. The ONLY anonymous write path is the menu's
      // self-registration («انضم للعائلة» / games gate / room join —
      // registerCustomer in db.js), and it is held to a strict KEY ALLOWLIST:
      // the old deny-list blocked the known loyalty/flag fields but still let
      // a hostile diner attach unlimited junk under any new name (free
      // storage at the venue's expense, or seeding a field a later feature
      // trusts). Loyalty/stats/membership writes all happen from staff
      // sessions (settle/cancel/refund paths), so they stay staff-only.
      match /customers/{id} {
        // The whole marketing list was one getDocs away from any account with a
        // login — a cleaner or a driver could export it. view_customers now gates
        // ENUMERATION; a single doc stays open to staff because the POS resolves a
        // walk-in by phoneId (getCustomerByPhone) and a cashier does not hold the
        // cap. The flagged escape hatch keeps the cashier board's «انتبه لهذا
        // العميل» warning working (watchFlaggedCustomers queries flagged == true,
        // so nothing else comes back through it).
        allow get: if isStaff(tid);
        allow list: if hasCap(tid, 'view_customers')
          || (isStaff(tid) && resource.data.get('flagged', false) == true);
        // lastOrderAt is in the anonymous allowlist because the Customers
        // screen orders by it and Firestore hides docs missing the ordered
        // field — self-registration stamps it as "last activity" so a new
        // guest is actually visible. Refreshing one's own recency is the
        // whole exposure; the money/loyalty fields stay staff-only.
        allow create: if isStaff(tid)
          || (request.resource.data.keys().hasOnly(['name', 'phone', 'source', 'registeredAt', 'lastOrderAt', 'updatedAt'])
              && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120))
              && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32)));
        allow update: if isStaff(tid)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'source', 'registeredAt', 'lastOrderAt', 'updatedAt'])
              && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120))
              && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 32)));
        allow delete: if isManager(tid);
      }

      // ---- member cards (VIP): public display mirror, get-by-token; staff write ----
      match /memberCards/{token} {
        allow get: if true; // diner opens their own card by its unguessable token
        // Listing every card is reading the member roster, so it follows the CRM
        // cap. Nothing in the app lists this collection today (cards are opened by
        // token), so the narrower rule costs no screen.
        allow list: if hasCap(tid, 'view_customers');
        allow write: if isStaff(tid);
      }
      // ---- phone→card lookup mirror: lets the menu recognize a returning member by
      // phone (get-by-phoneId). Holds only token/tier/discount, no PII. Staff write. ----
      match /memberPhones/{pid} {
        allow get: if true;
        allow list: if isStaff(tid);
        allow write: if isStaff(tid);
      }
      // ---- loyalty points ledger (earn/redeem statement): staff read + append ----
      match /loyaltyLog/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid);
        allow update, delete: if isManager(tid);
      }

      // ---- staff PIN secrets: NEVER client-readable. The 4-digit PIN hash
      // used to sit on the peer-readable staff doc — 10k candidates against
      // an unsalted fast hash meant any staffer could brute-force a
      // manager's PIN offline. Hashes (scrypt + per-record salt) live here
      // now; ONLY the verifyStaffPin / setStaffPinSecure Cloud Functions
      // (Admin SDK) touch them. ----
      match /staffPins/{uid} {
        allow read, write: if false;
      }

      // ---- staff directory: managers manage anyone; a staffer self-registers
      // ONLY their own doc within their own tenant (strict isolation). ----
      match /staff/{uid} {
        allow read: if isStaff(tid);
        // `role` was on the update denylist but not this one, and onStaffDocCreated
        // mints caps from whatever role the new doc names — so a staffer whose doc
        // had been deleted (exactly the post-firing state, users doc still bound)
        // could re-create it as 'manager' and be handed manager caps by the server.
        // It is not simply denied here: every staffer's doc is self-created on first
        // login (upsertStaffMember in auth.jsx) and it carries the role, so denying
        // the key would leave new hires with no directory doc and no caps mirror at
        // all. Instead the role must MATCH the users doc, which only the server and
        // a manager can write.
        allow create: if isManager(tid)
          || (isStaff(tid) && request.auth.uid == uid
              && (!('role' in request.resource.data) || request.resource.data.role == userDoc().get('role', 'staff'))
              && !request.resource.data.keys().hasAny(['salary', 'caps', 'capsCustom', 'deductions', 'workDays', 'shiftStart', 'shiftEnd', 'managerRating', 'pinHash', 'hasPin', 'staffId', 'hireDate']));
        // managerRating/pinHash/hasPin/capsCustom/staffId/hireDate are manager-
        // owned — a staffer must not be able to inflate their own evaluation
        // or fiddle the PIN flag (the hash itself lives in staffPins now).
        allow update: if isManager(tid)
          || (isStaff(tid) && request.auth.uid == uid
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['salary', 'role', 'caps', 'capsCustom', 'deductions', 'workDays', 'shiftStart', 'shiftEnd', 'active', 'managerRating', 'pinHash', 'hasPin', 'staffId', 'hireDate']));
        allow delete: if isManager(tid);
      }

      // ---- attendance: a staffer punches in/out for THEMSELVES; staff read, managers manage ----
      match /attendance/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid)
          && request.resource.data.staffUid == request.auth.uid
          && request.resource.data.at == request.time
          && request.resource.data.selfieUrl is string
          && request.resource.data.selfieUrl.size() > 0;
        allow update, delete: if isManager(tid);
      }

      // ---- leave requests: a staffer requests for THEMSELVES; staff read, managers decide ----
      match /leaves/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid)
          && request.resource.data.staffUid == request.auth.uid
          && request.resource.data.status == 'pending';
        allow update, delete: if isManager(tid);
      }

      // ---- announcements: managers post venue-wide, all staff read ----
      match /announcements/{id} {
        allow read: if isStaff(tid);
        allow create, update, delete: if isManager(tid);
      }

      // ---- status sessions (busy/break): a staffer logs & closes their OWN
      // sessions; staff read, managers manage. ----
      match /statusLog/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid) && request.resource.data.staffUid == request.auth.uid;
        allow update: if isManager(tid) || (isStaff(tid) && resource.data.staffUid == request.auth.uid);
        allow delete: if isManager(tid);
      }

      // ---- shifts (weekly schedule): managers assign, all staff read ----
      match /shifts/{id} {
        allow read: if isStaff(tid);
        allow create, update, delete: if isManager(tid);
      }

      // ---- shift swaps: a staffer requests with a coworker; the TARGET coworker
      // accepts/declines (peer-to-peer); managers can also manage. ----
      match /shiftSwaps/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid) && request.resource.data.fromUid == request.auth.uid;
        allow update: if isManager(tid) || (isStaff(tid) && resource.data.toUid == request.auth.uid);
        allow delete: if isManager(tid) || (isStaff(tid) && resource.data.fromUid == request.auth.uid);
      }

      // ---- push tokens (FCM): staff register their device; server reads via Admin SDK ----
      match /pushTokens/{id} {
        // pushToStaff trusts the `uid` field to decide who gets a managersOnly
        // push (nightly revenue, platform chat), so a device may only ever claim
        // ITSELF: with a blanket write a waiter could stamp the owner's uid on
        // their own token and read the venue's money over the lock screen — or
        // wipe every token doc and silence the venue's push with no trace.
        // No client reads this collection (the Admin SDK does), so read is closed.
        allow read: if false;
        allow create, update: if isStaff(tid) && request.resource.data.uid == request.auth.uid;
        allow delete: if isStaff(tid) && resource.data.uid == request.auth.uid;
      }

      // ---- staff device registry (name + heartbeat) — operational, non-sensitive ----
      match /devices/{id} {
        allow read, write: if isStaff(tid);
      }

      // ---- AI assistant conversations — STRICTLY PER USER: a staffer reads
      // and writes only chats whose uid field is their own (the doc id is also
      // uid-prefixed). This is what lets the same account find its chats from
      // any device, without ever exposing them to coworkers. ----
      match /aiChats/{id} {
        allow read, delete: if isStaff(tid) && resource.data.uid == request.auth.uid;
        allow create: if isStaff(tid) && request.resource.data.uid == request.auth.uid;
        allow update: if isStaff(tid) && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      }

      // ---- central media library: every upload is registered here so assets can
      // be reused anywhere (backgrounds, menu, signage…) without re-uploading.
      // Any staffer who can upload can register + browse; managers curate/delete. ----
      match /media/{id} {
        allow read: if isStaff(tid);
        allow create: if isStaff(tid);
        allow delete: if isStaff(tid);
        // Managers edit anything; other staff may only star/trash/restore
        // (the library soft-delete flow) — never rename/move/relink.
        allow update: if isManager(tid)
          || (isStaff(tid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fav', 'trashed', 'trashedAt']));
      }

      // ---- venue secrets (own WhatsApp number credentials, API keys) ----
      // NEVER public: the tenant root doc is world-readable, so anything secret
      // lives here instead. Managers manage; Cloud Functions read via Admin SDK.
      match /private/{id} {
        allow read, write: if hasCap(tid, 'manage_integrations');
      }

      // ---- misc tenant subcollections (meta, audit) ----
      match /meta/{id} {
        allow read: if true;
        allow write: if isManager(tid);
      }
    }

    // ================= PLATFORM CONSOLE (super-admin) =================

    // Membership roster. Bootstrap: create your own admin doc from the Firebase
    // Console (doc id = your auth uid). Clients can only verify THEIR OWN entry.
    match /platformAdmins/{uid} {
      // Any signed-in user may verify THEIR OWN entry; platform admins may read
      // the full roster (Roles screen). Role writes go through the setPlatformRole
      // Cloud Function (Admin SDK), never the client.
      allow get: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow write: if false;
    }

    // Cross-venue activity feed — written exclusively by Cloud Functions
    // (Admin SDK bypasses rules); the console reads it live.
    match /platformActivity/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Client error reports (code monitoring). Any signed-in principal (diners
    // may auth anonymously) may file a bounded, shape-constrained report; only
    // the platform reads/manages them.
    match /platformErrors/{id} {
      allow create: if isSignedIn()
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() < 2000
        // `componentStack` is React's owning-component chain for a render crash.
        // It has to be listed here: hasOnly() is exact, so a client sending a
        // field the allowlist does not name has its write REFUSED — which for
        // this collection means the error monitor goes silent rather than noisy,
        // the worse of the two failure modes.
        && request.resource.data.keys().hasOnly(['message', 'stack', 'componentStack', 'kind', 'url', 'ua', 'tenantId', 'tenantName', 'uid', 'status', 'at'])
        && (!('stack' in request.resource.data) || request.resource.data.stack.size() < 5000)
        && (!('componentStack' in request.resource.data) || request.resource.data.componentStack.size() < 5000);
      allow read, update, delete: if isPlatformAdmin();
    }

    // Support tickets/issues. Venue managers open + follow THEIR OWN venue's
    // tickets; the platform sees and manages all of them.
    match /platformIssues/{id} {
      allow create: if isPlatformAdmin()
        || (isSignedIn()
            && isManager(request.resource.data.tenantId)
            && request.resource.data.status == 'open');
      // Managers only (support tickets may carry account/billing context).
      allow read: if isPlatformAdmin()
        || (isSignedIn() && isManager(resource.data.tenantId));
      allow update: if isPlatformAdmin() || (isSignedIn() && isManager(resource.data.tenantId));
      allow delete: if isPlatformAdmin();
    }

    // Direct chat: one thread per venue (thread id == tenantId).
    // Venue managers and the platform both read/write the same thread.
    match /platformChats/{tid} {
      allow read, create, update: if isPlatformAdmin() || isManager(tid);
      allow delete: if isPlatformAdmin();
      match /messages/{mid} {
        allow read, create, update: if isPlatformAdmin() || isManager(tid);
        // A venue manager may unsend their OWN (from == 'venue') message; the
        // platform may delete any message (moderation).
        allow delete: if isPlatformAdmin()
          || (isManager(tid) && resource.data.from == 'venue');
      }
    }

    // Platform admin device tokens (FCM) for the strong-notification pipeline.
    match /platformPushTokens/{id} {
      allow read, write: if isPlatformAdmin();
    }

    // Global announcements queue — a Cloud Function fans each doc out to every
    // (matching) venue's announcements board.
    match /platformBroadcasts/{id} {
      // A broadcast fans out to EVERY venue — creating one is a superAdmin action.
      allow read: if isPlatformAdmin();
      allow write: if isPlatformSuper();
    }

    // Daily cross-venue rollups — written by the scheduled Cloud Function.
    match /platformStats/{id} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    // Private per-venue platform metadata: the console's internal note about a
    // venue + the negotiated custom subscription price. Deliberately OUTSIDE
    // the tenant doc — that doc is world-readable (public menus render from
    // it), and these two fields were leaking to anyone who fetched it. The
    // monthly billing function reads customPrice from here via Admin SDK.
    match /platformVenueMeta/{tid} {
      allow read: if isPlatformAdmin();
      allow write: if isPlatformSuper();
    }

    // ---- extended platform features (invoices, config, audit, growth, …) ----
    // Platform-only collections: only the console (or its Cloud Functions) touch them.
    match /platformInvoices/{id}   { allow read: if isPlatformAdmin() || (isSignedIn() && isManager(resource.data.tenantId)); allow write: if isPlatformAdmin(); }
    match /platformCoupons/{id}    { allow read, write: if isPlatformAdmin(); }
    match /platformConfig/{id}     { allow read, write: if isPlatformAdmin(); }
    // Landing-page CMS doc: the public marketing page reads it unauthenticated
    // (overlapping matches are OR'd — writes still require a platform admin).
    match /platformConfig/landing  { allow read: if true; }
    // The price list. Public-read for the same reason the landing page exists:
    // prices, list prices, the promo window and the per-plan feature bullets
    // are all printed on a page anyone can load. Reading it directly is what
    // stops the marketing page from advertising one number while the invoice
    // charges another. WRITES still require a platform admin (rule above).
    // CONSTRAINT: nothing private may ever be stored on this document.
    match /platformConfig/plans    { allow read: if true; }

    // Realistic-3D conversion log: managers read it for the usage meter;
    // ONLY Cloud Functions write it (Admin SDK bypasses rules).
    match /tenants/{tid}/ar3dJobs/{id} {
      allow read: if isSignedIn() && isManager(tid);
      allow write: if false;
    }

    // Spend meters (functions/spend.js) — one doc per venue per month holding
    // how many WhatsApp/email/AI units it has used and how many were refused.
    // A manager READS it: it is their own usage meter, and a venue that is
    // being throttled deserves to see why rather than watch messages vanish.
    // NOBODY writes it from a client. The whole point of moving the ceiling
    // server-side was that the old counters were client-writable, so a venue
    // could zero its own usage and keep spending the platform's money.
    match /tenants/{tid}/counters/{id} {
      allow read: if isSignedIn() && isManager(tid);
      allow write: if false;
    }

    // Free-form print designs (Print Studio): managers + menu-capable staff.
    match /tenants/{tid}/printDesigns/{id} {
      allow read, write: if isSignedIn() && (isManager(tid) || hasCap(tid, 'manage_menu'));
    }
    match /platformCannedResponses/{id} { allow read, write: if isPlatformAdmin(); }
    match /platformTemplates/{id}  { allow read, write: if isPlatformAdmin(); }
    match /platformOnboarding/{id} { allow read, write: if isPlatformAdmin(); }
    match /platformReferrals/{id}  { allow read, write: if isPlatformAdmin(); }
    match /platformExports/{id}    { allow read, write: if isPlatformAdmin(); }
    match /platformAudit/{id}      { allow read: if isPlatformAdmin(); allow write: if false; }
    // Error-push throttle signatures (written by onErrorReported via Admin SDK).
    match /platformErrorSignatures/{id} { allow read, write: if false; }

    // ---- branches: one owner, several venues ----
    // A group is read by whoever is currently WORKING inside one of its
    // branches. It lives at the top level, not under tenants/{tid}, because
    // that document is world-readable and group billing state must not be.
    match /venueGroups/{gid} {
      allow read: if isPlatformAdmin()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/tenants/$(userDoc().tenantId))
            && get(/databases/$(database)/documents/tenants/$(userDoc().tenantId)).data.groupId == gid);
      // Groups and branches are created only by the createBranch callable.
      allow write: if false;
      match /daily/{date} {
        allow read: if isPlatformAdmin()
          || (isSignedIn()
              && exists(/databases/$(database)/documents/tenants/$(userDoc().tenantId))
              && get(/databases/$(database)/documents/tenants/$(userDoc().tenantId)).data.groupId == gid);
        allow write: if false;
      }
    }

    // ---- observability ----
    // Live health board + the operational alert feed. Written by the probes
    // (Admin SDK). An admin may ACKNOWLEDGE an alert, and nothing else: the
    // allowed keys are pinned so the field set cannot be repurposed to rewrite
    // an alert's severity or body after the fact.
    match /platformHealth/{id} { allow read: if isPlatformAdmin(); allow write: if false; }
    match /platformAlerts/{id} {
      allow read: if isPlatformAdmin();
      allow create, delete: if false;
      allow update: if isPlatformAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'ackedBy', 'ackedAt', 'ackNote', 'snoozeUntil']);
    }
    // Estimate-vs-actual per vendor per month. Platform-admin writable because
    // the «actual» comes from a human reading an invoice — there is no API for
    // it while the vendor accounts are shared with the owner's other systems.
    match /platformVendorSpend/{id} { allow read, write: if isPlatformAdmin(); }

    // Quotations carry a prospect's VAT number AND a negotiated price. A
    // leaked negotiated price is a commercial injury, so the collection is
    // closed to everyone but the console — the prospect's own view goes
    // through the getPublicQuote callable, which compares a token. An
    // unguessable document id is not a permission model.
    match /platformQuotes/{id} { allow read: if isPlatformAdmin(); allow write: if false; }

    // Invoice / quotation sequence counters, and the platform-wide Gemini
    // per-minute counter. SERVER ONLY: a client-writable invoice counter is a
    // way to mint duplicate legal numbers, and a client-writable spend counter
    // is a way to erase the wall in front of Google's rate limit.
    match /platformCounters/{id} { allow read, write: if false; }

    // Public status page — anyone can read; only the platform posts incidents.
    match /platformStatus/{id} {
      allow read: if true;
      allow write: if isPlatformAdmin();
    }
    // NPS responses — venue managers/diners may submit a bounded rating; platform manages.
    match /platformNps/{id} {
      allow create: if isSignedIn() && request.resource.data.rating is number
        && request.resource.data.rating >= 0 && request.resource.data.rating <= 10;
      allow read, update, delete: if isPlatformAdmin();
    }
    // Consent records — a signed-in party may record consent; platform reads/manages.
    // Bounded exactly like platformErrors above: an unconstrained create made this
    // free unlimited storage on the platform's bill, and let anyone log a consent
    // in someone else's name. The two writers are recordLegalConsent (legal.js)
    // and recordConsent (platformCompliance.js) — hasOnly() is exact, so a new
    // field on either must be added here or the record is refused.
    match /platformConsent/{id} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['tenantId', 'uid', 'byName', 'by', 'kind', 'docs', 'version', 'at'])
        && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
        && request.resource.data.kind is string
        && request.resource.data.kind.size() < 60
        && (!('byName' in request.resource.data) || request.resource.data.byName.size() < 200)
        && (!('by' in request.resource.data) || request.resource.data.by.size() < 120)
        && (!('version' in request.resource.data) || request.resource.data.version.size() < 40)
        && (!('docs' in request.resource.data) || request.resource.data.docs.size() <= 20);
      allow read, update, delete: if isPlatformAdmin();
    }
  }
}
